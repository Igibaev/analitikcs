# Jira (self-hosted)
JIRA_URL=https://jira.yourcompany.com
JIRA_USER=your.email@company.com
JIRA_TOKEN=your_jira_api_token

# GitLab (self-hosted)
GITLAB_URL=https://gitlab.yourcompany.com
GITLAB_TOKEN=your_gitlab_private_token

# Team config
JIRA_PROJECT=QBS
# Custom field name for "Team Link" — find it via /rest/api/2/field
JIRA_TEAM_FIELD=customfield_10100
JIRA_TEAM_VALUE=Backend Core

# Periods
Q1_START=2025-01-01
Q1_END=2025-03-31
Q2_START=2025-04-01
Q2_END=2025-06-30
