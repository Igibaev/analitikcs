# Jira (self-hosted)
JIRA_URL=https://jira.yourcompany.com
JIRA_USER=your.email@company.com
JIRA_TOKEN=your_jira_api_token

# Jira project & team filter
JIRA_PROJECT=QBS
# Optional: custom field for team filter (find ID via: python main.py --find-fields)
JIRA_TEAM_FIELD=customfield_10100
JIRA_TEAM_VALUE=Backend Core

# GitLab (self-hosted)
GITLAB_URL=https://gitlab.yourcompany.com
GITLAB_TOKEN=your_gitlab_private_token
GITLAB_GROUP=company/backend

# Team members — comma-separated GitLab usernames
GITLAB_USERNAMES=ivan.petrov,anna.sidorova,dmitry.kovalev,olga.nikitina

# Analysis periods
Q1_START=2025-01-01
Q1_END=2025-03-31
Q2_START=2025-04-01
Q2_END=2025-06-30
